#!/usr/bin/env bash
# cachy-agent-install <name> - eksik agent CLI'yi resmi yoluyla kurar
# Kurulum komutu agents.conf'un `install` alanından gelir; "-" ise harici
# kurulumdur (bu script kurmaz). Config: cachy-agent-agents get <id> install.
set -euo pipefail
NAME="${1:-}"
# Sorgu ONAYDAN ÖNCE yapılır: v0.1.0'de bilinmeyen ad `case` ile anında
# "bilinmeyen agent" + exit 1 veriyordu, kullanıcıya hiç soru sorulmadan.
# Sorgu onaydan sonraya kalırsa `cachy-agent-install uydurma` önce
# "uydurma kurulacak... Devam?" diye sorup SONRA reddediyordu — bu bir davranış
# gerilemesi. `get` bilinmeyen id'de exit 1 + stderr verir; `set -e` de
# `NAME`'i hiç kullanılmadan çıkmamıza izin verir (eskiden `case` aynı işi
# yapıyordu, yani mesaj biçimi dışında davranış aynı).
cmd="$(cachy-agent-agents get "$NAME" install)"
if [[ -z "$cmd" || "$cmd" == "-" ]]; then
  echo "$NAME için otomatik kurulum yok (harici kurulum)" >&2; exit 1
fi
read -rp "$NAME kurulacak (harici kurulum). Devam? [E/h] " ans || true
[[ "${ans:-}" =~ ^[HhnN] ]] && echo "Vazgeçildi." && exit 0
# ~ ve $HOME genişletmesi kurulum komutunun kendi bash'ine bırakılır.
bash -c "$cmd"
if command -v "$NAME" >/dev/null 2>&1; then
  echo "OK: $NAME kuruldu."
  # `login` "-" ise giriş adımı yok -> bu satır atlanır.
  login="$(cachy-agent-agents get "$NAME" login)"
  if [[ -n "$login" && "$login" != "-" ]]; then
    echo "Son adım: terminalde '$login' ile giriş yap."
  fi
  exec cachy-agent --inline "$NAME"
else
  echo "Kurulum tamamlanamadı ($NAME bulunamadı). Çıktıdaki hataya bak." >&2
  read -rp "Çıkmak için Enter..."
  exit 1
fi
