#!/usr/bin/env bash
# cachy-agent-usage-update - kullanım kolektörleri orkestratörü
# Kullanım: cachy-agent-usage-update [agent...]
# Argümansız: agents.conf'taki TÜM agentlar (cachy-agent-agents list).
# Verilirse sadece onları çalıştırır.
# Her kolektör (timeout 30) stdout JSON'u doğrulanıp
# ~/.local/state/cachy-agent/agents/usage/<agent>.json yoluna atomik yazılır.
# Başarısız kolektör veya kolektörü olmayan agent sessizce atlanır, exit 0 korunur.
set -u
# Katalog okuyucu ve koleksiyon dizini AYNI $BIN'den gelir (Ruling 10).
# systemd --user unit'inin PATH'i login shell'inkinden farklıdır; bare
# `cachy-agent-agents` çağrısı orada `command not found` (rc 127) veriyor ve
# `mapfile < <(...)` bunu YUTUYORDU — script rc 0 dönüp sıfır dosya yazıyordu,
# yani kullanım verisi 15 dakikada bir sessizce ölüyordu. `CACHY_AGENT_BIN_DIR`
# testler ve denemeler için bu dizini ezer.
BIN="${CACHY_AGENT_BIN_DIR:-$HOME/.local/bin}"
BIN_DIR="$BIN"
AGENTS_BIN="$BIN/cachy-agent-agents"
OUT_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cachy-agent/agents/usage"

if [[ $# -gt 0 ]]; then
  AGENTS=("$@")
else
  # Config okunamazsa liste boş gelir -> döngü hiç çalışmaz, exit 0 korunur
  # ("sessizce atla" davranışı değişmez).
  #
  # stderr BURADA KASTEN SUSTURULMAZ. Bu script systemd timer ile 15 dakikada
  # bir çalışır; config bozuksa `cachy-agent-agents` tek satır hatayı stderr'a
  # basar ve kullanım verisi sessizce ölür. Sıfır çıktı + exit 0 "her şey yolunda"
  # izlenimi yaratırdı. Tek satırlık journal gürültüsü, kullanıcının verinin
  # neden durduğunu göremesine yeğdir.
  #
  # `mapfile`'in KENDİ exit kodu her zaman 0'dır; asıl sorgunun kodu ayrı
  # yakalanmalıdır (I-3). Sorgu başarısızsa liste boş kalır, döngü hiç
  # çalışmaz ve kullanıcı hatayı stderr'dan görmüş olur.
  ajanlar="$("$AGENTS_BIN" list)" || ajanlar=""
  # `mapfile <<< ""` TEK bir boş eleman üretir (sıfır değil); döngü bir kez
  # boş isimle döner. `clean` boş olduğu için `continue` zaten atlar, ama
  # boş girdide diziyi hiç doldurmamak daha dürüst.
  if [[ -n "$ajanlar" ]]; then mapfile -t AGENTS <<< "$ajanlar"; fi
fi

mkdir -p "$OUT_DIR"

for agent in "${AGENTS[@]}"; do
  # Sadeleştir: yol traversal engelle
  clean="$(printf '%s' "$agent" | tr -cd 'A-Za-z0-9_-')"
  [[ -z "$clean" ]] && continue
  collector="$BIN_DIR/cachy-agent-usage-$clean"
  if [[ ! -x "$collector" ]]; then
    continue
  fi
  out="$(timeout 30 "$collector" 2>/dev/null)" || continue
  [[ -z "$out" ]] && continue
  if ! printf '%s' "$out" | python3 -c "import json,sys; json.load(sys.stdin)" 2>/dev/null; then
    continue
  fi
  tmp="$OUT_DIR/$clean.json.tmp.$$"
  printf '%s' "$out" > "$tmp"
  mv -f "$tmp" "$OUT_DIR/$clean.json"
done
exit 0
