#!/usr/bin/env bash
# cachy-agent-menu - fuzzel picker -> alacritty agent terminal
# fuzzel yoksa eski metin prompt'a düşer (kısayol hep çalışır)
# Agent listesi TEK kaynaktan gelir: cachy-agent-agents list (agents.conf).
# Burada hiçbir agent adı sabit yazılı değildir.
#
# BU SCRIPT KABUKTAN DEĞİL desktop entry'den (bkz. cachy-agent.desktop
# Exec=__HOME__/.local/bin/cachy-agent-menu) çalışır; KDE'nin başlattığı
# süreçte PATH'in `~/.local/bin` içerdiği garanti DEĞİLDİR. Aynı sebeple
# systemd --user unit'inin PATH'i login shell'inkinden farklıdır. Bu yüzden
# kardeş binary'ler BARE adla değil, mutlak $BIN yoluyla çağrılır (Ruling 10).
# Aynı $BIN değişkeni `CACHY_AGENT_BIN_DIR` ile ezilebilir — testler tek sed
# ile dört çağıranın hepsini stub dizinine geçirir.
set -euo pipefail
BIN="${CACHY_AGENT_BIN_DIR:-$HOME/.local/bin}"
AGENT_BIN="$BIN/cachy-agent"
AGENTS_BIN="$BIN/cachy-agent-agents"

# Config preflightı fuzzel dalının DIŞINDA: fuzzel kurulu değilken de bozuk
# config boş bir picker yerine sebebi göstermeli. (v0.1.0'de liste sabitti,
# bu yol imkânsızdı.)
#
# Liste TEK kez okunur — iki ayrı `list` çağrısı config bozukken aynı hatayı
# stderr'a İKİ kez basardı. Sorgunun exit kodu `list`'in kendisindendir.
# `set -e` altında düz `ajanlar="$(...)"` başarısızlıkta kabuğu ÖLDÜRÜRDÜ ve
# `liste_rc` hiç okunamazdı; `&& ... || ...` zinciri hem atlamayı hem kodu
# güvenle almayı sağlar (&&/|| listesinde `set -e` tetiklenmez).
ajanlar="$("$AGENTS_BIN" list)" && liste_rc=0 || liste_rc=$?
if [[ $liste_rc -ne 0 ]]; then
  # Config yolu bilerek YAZILMAZ: `cachy-agent-agents` tanı mesajında çözülmüş
  # yolu zaten basıyor (XDG_CONFIG_HOME dahil). Burada yeniden türetmek
  # XDG_CONFIG_HOME'i düşürür ve BAŞKA bir dosyayı adı gösterebilirdi.
  # Yalnızca ne yapılması gerektiğini söylüyoruz.
  echo "cachy-agent-menu: agent listesi alınamadı, cachy-agent --help'e bak" >&2
  exit 1
fi

if command -v fuzzel >/dev/null 2>&1; then
  installed=()
  missing=()
  while IFS= read -r a; do
    [[ -n "$a" ]] || continue
    if command -v "$a" >/dev/null 2>&1; then installed+=("$a"); else missing+=("$a"); fi
  done <<< "$ajanlar"
  # Config geçerli ama hiç agent satırı yoksa menü boş kalır (v0.1.0'de de
  # öyleydi: kullanıcı config'ini boşaltırsa menü açılmaz, hata da yoktur).
  [[ ${#installed[@]} -eq 0 && ${#missing[@]} -eq 0 ]] && exit 0
  list=$(printf '%s\n' "${installed[@]}")
  if [[ ${#installed[@]} -gt 0 ]]; then
    list+=$'\n──────────────────'
    for a in "${installed[@]}"; do list+=$'\n★ '"$a"' (varsayılan yap)'; done
  fi
  if [[ ${#missing[@]} -gt 0 ]]; then
    list+=$'\n──────────────────'
    for m in "${missing[@]}"; do list+=$'\n+ '"$m"' (kur)'; done
  fi
  sel=$(printf '%s\n' "$list" | fuzzel --dmenu --prompt 'Agent: ' 2>/dev/null || true)
  [[ -z "${sel:-}" ]] && exit 0
  case "$sel" in
    ─*) exit 0 ;;
    "★ "*)
      name=$(echo "$sel" | sed 's/^★ //; s/ (varsayılan yap)$//')
      # fuzzel satırdan sökülen bu bir id olmak ZORUNDA; config'te yoksa
      # menü kapatılır (eskiden sabit `case` listesi vardı). Config yukarıda
      # zaten okundu, bu yüzden `2>/dev/null` burada YALNIZCA "bilinmeyen id"
      # mesajını susturur; config hatası zaten üstte raporlandı.
      "$AGENTS_BIN" known "$name" 2>/dev/null || exit 0
      "$AGENT_BIN" default "$name" >/dev/null
      if command -v notify-send >/dev/null 2>&1; then notify-send "cachyAgent" "Varsayılan agent: $name"; fi
      exit 0
      ;;
    "+ "*)
      name=$(echo "$sel" | sed 's/^+ //; s/ (kur)$//')
      "$AGENTS_BIN" known "$name" 2>/dev/null || exit 0
      exec /usr/bin/alacritty --class CachyAgent -e "$BIN/cachy-agent-install" "$name"
      ;;
    *)
      # Düz satır: id config'te yoksa sessizce çık, varsa -open'e devret.
      "$AGENTS_BIN" known "$sel" 2>/dev/null || exit 0
      ;;
  esac
  exec /usr/bin/alacritty --class CachyAgent -e "$AGENT_BIN-open" "$sel"
else
  exec /usr/bin/alacritty --class CachyAgent -e "$AGENT_BIN" --pick
fi
