#!/usr/bin/env bash
# cachy-agent-menu - fuzzel picker -> alacritty agent terminal
# fuzzel yoksa eski metin prompt'a düşer (kısayol hep çalışır)
# Agent listesi TEK kaynaktan gelir: cachy-agent-agents list (agents.conf).
# Burada hiçbir agent adı sabit yazılı değildir.
#
# BU SCRIPT KABUKTAN DEĞİL desktop entry'den (bkz. cachy-agent.desktop
# Exec=__HOME__/.local/bin/cachy-agent-menu) çalışır; KDE'nin başlattığı
# süreçte PATH'in `~/.local/bin` içerdiği garanti DEĞİLDİR. Bu yüzden kardeş
# binary'ler bare adla değil, mutlak $BIN_DIR yoluyla çağrılır — v0.1.0'de de
# böyleydi, davranış korunur. Tek değişiklik: yol artık üç ayrı yerde
# yazılmıyor, tek `BIN_DIR` sabitinden geliyor (test de tek sed ile geçirir).
set -euo pipefail
BIN_DIR="$HOME/.local/bin"
AGENT_BIN="$BIN_DIR/cachy-agent"
AGENTS_BIN="$BIN_DIR/cachy-agent-agents"
if command -v fuzzel >/dev/null 2>&1; then
  installed=()
  missing=()
  # Liste TEK kez okunur. İki ayrı `list` çağrısı (biri döngüye, biri "boş mu"
  # kontrolüne) config bozukken aynı hatayı stderr'a İKİ kez basardı.
  # Sorgunun exit kodu `list`'in kendisindendir. `set -e` altında düz
  # `ajanlar="$(...)"` başarısızlıkta kabuğu ÖLDÜRÜRDÜ ve `liste_rc` hiç
  # okunamazdı; `&& ... || ...` zinciri hem atlamayı hem kodu güvenle almayı
  # sağlar (&&/|| listesinde `set -e` tetiklenmez).
  ajanlar="$("$AGENTS_BIN" list)" && liste_rc=0 || liste_rc=$?
  if [[ $liste_rc -ne 0 ]]; then
    # v0.1.0'de imkânsızdı (sabit liste vardı). Config'e bağlandıktan sonra
    # config eksik/bozuksa buraya düşer; v0.1.0'deki "sessizce boş menü"
    # davranışı kullanıcıya hiçbir sebep göstermeden pencereyi kapatıyordu.
    # `cachy-agent-agents` tanı mesajını zaten stderr'a bastı; tek satır daha
    # ekliyoruz ve ne yapılacağını söylüyoruz.
    echo "cachy-agent-menu: agent listesi alınamadı (config: ${CACHY_AGENT_CONFIG:-$HOME/.config/cachy-agent/agents.conf})" >&2
    exit 1
  fi
  while IFS= read -r a; do
    [[ -n "$a" ]] || continue
    if command -v "$a" >/dev/null 2>&1; then installed+=("$a"); else missing+=("$a"); fi
  done <<< "$ajanlar"
  # Config geçerli ama hiç agent satırı yoksa menü boş kalır (v0.1.0'de de
  # öyleydi: kullanıcı config'ini boşaltırsa menü açılmaz, hata da yoktur).
  [[ ${#installed[@]} -eq 0 && ${#missing[@]} -eq 0 ]] && exit 0
  list=$(printf '%s\n' "${installed[@]}")
  if [[ ${#installed[@]} -gt 0 ]]; then
    list+=$'\n──────────────────'
    for a in "${installed[@]}"; do list+=$'\n★ '"$a"' (varsayılan yap)'; done
  fi
  if [[ ${#missing[@]} -gt 0 ]]; then
    list+=$'\n──────────────────'
    for m in "${missing[@]}"; do list+=$'\n+ '"$m"' (kur)'; done
  fi
  sel=$(printf '%s\n' "$list" | fuzzel --dmenu --prompt 'Agent: ' 2>/dev/null || true)
  [[ -z "${sel:-}" ]] && exit 0
  case "$sel" in
    ─*) exit 0 ;;
    "★ "*)
      name=$(echo "$sel" | sed 's/^★ //; s/ (varsayılan yap)$//')
      # fuzzel satırdan sökülen bu bir id olmak ZORUNDA; config'te yoksa
      # menü kapatılır (eskiden sabit `case` listesi vardı).
      "$AGENTS_BIN" known "$name" 2>/dev/null || exit 0
      "$AGENT_BIN" default "$name" >/dev/null
      if command -v notify-send >/dev/null 2>&1; then notify-send "cachyAgent" "Varsayılan agent: $name"; fi
      exit 0
      ;;
    "+ "*)
      name=$(echo "$sel" | sed 's/^+ //; s/ (kur)$//')
      "$AGENTS_BIN" known "$name" 2>/dev/null || exit 0
      exec /usr/bin/alacritty --class CachyAgent -e "$BIN_DIR/cachy-agent-install" "$name"
      ;;
    *)
      # Düz satır: id config'te yoksa sessizce çık, varsa -open'e devret.
      "$AGENTS_BIN" known "$sel" 2>/dev/null || exit 0
      ;;
  esac
  exec /usr/bin/alacritty --class CachyAgent -e "$AGENT_BIN-open" "$sel"
else
  exec /usr/bin/alacritty --class CachyAgent -e "$AGENT_BIN" --pick
fi
