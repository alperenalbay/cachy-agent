#!/usr/bin/env bash
set -euo pipefail
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cachy-agent"
mkdir -p "$STATE_DIR" "$HOME/.config/cachy-agent/mute"
[[ -f "$HOME/.config/cachy-agent/mute-all" ]] && echo "crash-watch muted globally, sleeping" && sleep infinity
journalctl -f -o cat MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1 2>/dev/null | while read -r line; do
  # satır formatı: "Process 17984 (plasmashell) of user 1000 dumped core."
  PID=$(echo "$line" | grep -oP '^Process \K[0-9]+' | head -1 || true)
  COMM=$(echo "$line" | grep -oP '^Process [0-9]+ \(\K[^)]+' | head -1 | tr -cd 'A-Za-z0-9._-' || true)
  UID_NUM=$(echo "$line" | grep -oP 'of user \K[0-9]+' | head -1 || true)
  [[ -z "${PID:-}" ]] && continue
  [[ "$PID" =~ ^[0-9]+$ ]] || continue
  [[ -z "$COMM" ]] && COMM=unknown
  [[ "${UID_NUM:-}" != "$(id -u)" ]] && continue
  [[ -f "$HOME/.config/cachy-agent/mute/$COMM" ]] && continue
  [[ -f "$HOME/.config/cachy-agent/mute-all" ]] && continue
  NOW=$(date +%s); LAST=0; LAST_FILE="$STATE_DIR/last-crash-$COMM"; [[ -f "$LAST_FILE" ]] && LAST=$(cat "$LAST_FILE" || echo 0); [[ $LAST =~ ^[0-9]+$ ]] || LAST=0
  if (( NOW - LAST < 60 )); then continue; fi
  echo "$NOW" > "$LAST_FILE"
  python3 "$HOME/.local/bin/cachy-notify-action.py" \
    "Crash: $COMM ($PID)" \
    "$COMM çöktü. İncelemek için tıkla." \
    "alacritty --class CachyAgent -e cachy-agent-crash $PID $COMM" &
done
