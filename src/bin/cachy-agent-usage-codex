#!/usr/bin/env bash
#
# cachy-agent-usage-codex — Codex rate-limitlerini ORTAK ŞEMADA stdout'a JSON basar.
#
# Yöntem (kanıtlı yol): stdio üzerinden JSON-RPC
#   initialize -> initialized -> account/rateLimits/read
#   borusu `timeout 15 codex -s read-only app-server` içine akıtılır;
#   `rateLimits.primary/secondary.{usedPercent,resetsAt}` alanları limits'e çevrilir.
#   windowDurationMins 10080 -> "Weekly (7-day)", diğerleri süreyle etiketlenir.
#
# Çıktı şeması:
# {"schemaVersion":1,"id":"codex","name":"codex","updatedAt":"<ISO-8601 UTC>",
#  "ready":true/false,"tierLabel":"<planType varsa>",
#  "limits":[{"label":"...","percent":0.0-1.0,"resetsAt":"ISO-8601"}],
#  "todayPrompts":0,"todaySessions":0,"todayTotalTokens":0,
#  "totalPrompts":0,"totalSessions":0}
#
# Kurallar:
# - Her dış komut `timeout` ile sarılır (app-server asılmasın).
# - Auth yoksa veya RPC başarısızsa: ready:false, limits:[] basılır, exit 0.
# - Local session sayımı yapılmaz (today/total alanları 0 kalır).
# - Secret/token değerleri asla yazdırılmaz.

set -u

AUTH_FILE="${HOME}/.codex/auth.json"
RPC_TIMEOUT=15

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }

not_ready() {
  printf '{"schemaVersion":1,"id":"codex","name":"codex","updatedAt":"%s","ready":false,"tierLabel":"","limits":[],"todayPrompts":0,"todaySessions":0,"todayTotalTokens":0,"totalPrompts":0,"totalSessions":0}\n' "$(now_iso)"
  exit 0
}

[ -f "$AUTH_FILE" ] || not_ready
command -v codex >/dev/null 2>&1 || not_ready
command -v python3 >/dev/null 2>&1 || not_ready
command -v timeout >/dev/null 2>&1 || not_ready

CODEX_BIN="$(command -v codex)"

timeout 25 python3 - "$CODEX_BIN" "$RPC_TIMEOUT" <<'PYEOF' || not_ready
import json
import select
import subprocess
import sys
import time
from datetime import datetime, timezone

CODEX_BIN = sys.argv[1]
try:
    RPC_TIMEOUT = float(sys.argv[2])
except (IndexError, ValueError):
    RPC_TIMEOUT = 15.0


def iso_utc(ts):
    """Unix epoch (sn) -> ISO-8601 UTC; bilinmiyorsa None."""
    try:
        return datetime.fromtimestamp(int(ts), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (TypeError, ValueError, OSError, OverflowError):
        return None


def dur_label(mins):
    """windowDurationMins -> etiket. 10080 -> 'Weekly (7-day)', diğerleri süreyle."""
    try:
        mins = int(mins)
    except (TypeError, ValueError):
        return "Usage"
    if mins == 10080:
        return "Weekly (7-day)"
    if mins % 43200 == 0:
        return "Monthly (%d-day)" % (mins // 1440)
    if mins % 10080 == 0:
        return "%d-week (%d-day)" % (mins // 10080, mins // 1440)
    if mins % 1440 == 0:
        return "%d-day" % (mins // 1440)
    if mins % 60 == 0:
        return "%d-hour" % (mins // 60)
    return "%d-min" % mins


def emit(ready, tier="", limits=()):
    print(json.dumps({
        "schemaVersion": 1,
        "id": "codex",
        "name": "codex",
        "updatedAt": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "ready": ready,
        "tierLabel": tier,
        "limits": list(limits),
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "totalPrompts": 0,
        "totalSessions": 0,
    }))


def main():
    proc = subprocess.Popen(
        [CODEX_BIN, "-s", "read-only", "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    try:
        proc.stdin.write('{"id":1,"method":"initialize",'
                         '"params":{"clientInfo":{"name":"cachy-agent","version":"1.0"}}}\n')
        proc.stdin.write('{"method":"initialized"}\n')
        proc.stdin.write('{"id":2,"method":"account/rateLimits/read","params":null}\n')
        proc.stdin.flush()
        answer = None
        end = time.time() + RPC_TIMEOUT
        while time.time() < end:
            remaining = end - time.time()
            ready_fds, _, _ = select.select([proc.stdout], [], [], max(0.1, remaining))
            if not ready_fds:
                break
            line = proc.stdout.readline()
            if not line:
                break
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if isinstance(obj, dict) and obj.get("id") == 2:
                answer = obj
                break
    finally:
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            proc.terminate()
        except Exception:
            pass
    if not isinstance(answer, dict) or not isinstance(answer.get("result"), dict):
        return 1
    result = answer["result"]
    buckets = []
    by_id = result.get("rateLimitsByLimitId")
    if isinstance(by_id, dict) and by_id:
        for value in by_id.values():
            if isinstance(value, dict):
                buckets.append(value)
    if not buckets and isinstance(result.get("rateLimits"), dict):
        buckets.append(result["rateLimits"])
    if not buckets:
        return 1
    multi = len(buckets) > 1
    limits = []
    for bucket in buckets:
        tag = bucket.get("limitName") or bucket.get("limitId") or ""
        wins = [(kind, bucket.get(kind)) for kind in ("primary", "secondary")]
        wins = [(kind, win) for kind, win in wins if isinstance(win, dict)]
        for kind, win in wins:
            try:
                pct = max(0.0, min(1.0, float(win.get("usedPercent", 0)) / 100.0))
            except (TypeError, ValueError):
                pct = 0.0
            label = dur_label(win.get("windowDurationMins"))
            if len(wins) > 1:
                label += " (%s)" % kind
            if multi and tag:
                label = "%s %s" % (tag, label)
            limits.append({
                "label": label,
                "percent": pct,
                "resetsAt": iso_utc(win.get("resetsAt")),
            })
    tier = ""
    for bucket in buckets:
        if bucket.get("planType"):
            tier = str(bucket["planType"])
            break
    emit(True, tier, limits)
    return 0


sys.exit(main())
PYEOF
