#!/usr/bin/env bash
set -euo pipefail
PID="${1:-}"; COMM="${2:-unknown}"
if [[ -z "$PID" ]]; then echo "kullanım: cachy-agent-crash <pid> [comm]" >&2; exit 1; fi
DUMP=$(coredumpctl info "$PID" 2>&1 | head -50 | head -c 4000 || echo "dump yok")
LOGS=$(journalctl _PID="$PID" -n 100 --no-pager 2>&1 | tail -100 | head -c 4000 || echo "journal yok")
SIG=$(echo "$DUMP" | grep -oP 'Signal: \K[0-9]+' | head -1 || true)
CODE=$(echo "$DUMP" | grep -oP 'si_code: \K[A-Z_]+' | head -1 || true)
case "$SIG:${CODE:-}" in
  11:SI_USER|11:SI_TKILL) echo ">> Ön-teşhis: dışarıdan kill ile öldürülmüş (sinyal $SIG, $CODE) — gerçek bellek crash'i değil." ;;
  15:*) echo ">> Ön-teşhis: normal sonlandırma isteği (SIGTERM) — crash değil." ;;
  6:*) echo ">> Ön-teşhis: abort/assert (SIGABRT) — heap veya assert hatası şüphesi." ;;
  11:SEGV_MAPERR) echo ">> Ön-teşhis: geçersiz bellek erişimi (eşlenmemiş adres)." ;;
  11:SEGV_ACCERR) echo ">> Ön-teşhis: bellek izin ihlali (salt-okunur alana yazma vb.)." ;;
  *) echo ">> Ön-teşhis: sinyal $SIG ${CODE:-bilinmiyor} — detay agent analizinde." ;;
esac
echo ">> Detaylı analiz yükleniyor..."
cachy-agent --prompt "Crash diagnose: comm=$COMM pid=$PID. coredump: $DUMP. logs: $LOGS. SKILL: ~/.config/opencode/skills/diagnose-crash/SKILL.md" || {
  echo "Agent çalıştırılamadı (giriş/login gerekli olabilir). Manuel dene: cachy-agent --inline" >&2
  read -rp "Kapatmak için Enter..." || true
  exit 1
}
SEED_DUMP=$(echo "$DUMP" | head -25 | head -c 1500)
exec cachy-agent-open "$(cachy-agent default)" "Az önce pid=$PID comm=$COMM crash'ini diagnose ettin (sinyal=$SIG si_code=$CODE). Coredump özeti: $SEED_DUMP. Kullanıcının fix komutlarını bekle, onay almadan yıkıcı işlem yapma."
