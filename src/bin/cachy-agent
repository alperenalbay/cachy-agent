#!/usr/bin/env bash
# cachy-agent - Omarchy omarchy-agent'in CachyOS/KDE karşılığı
set -euo pipefail
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cachy-agent"
DEFAULT_FILE="$CONFIG_DIR/default-agent"

default_agent() { [[ -f "$DEFAULT_FILE" ]] && cat "$DEFAULT_FILE" || echo "opencode"; }

# Agent listesi ve bayraklar TEK kaynaktan gelir: agents.conf (spec §5.4).
# Burada hiçbir agent adı sabit yazılı değildir.
run_agent() {
  local agent="$1"; shift || true
  if ! cachy-agent-agents known "$agent" 2>/dev/null; then
    echo "bilinmeyen agent: $agent (bilinenler: $(cachy-agent-agents ids))" >&2
    return 1
  fi
  if [[ "$PWD" == "$HOME" ]]; then
    local wd; wd="$(cachy-agent-agents workdir)"
    [[ -d "$wd" ]] && cd "$wd"
  fi
  local flags pf
  flags="$(cachy-agent-agents get "$agent" flags)"
  pf="$(cachy-agent-agents get "$agent" prompt_flag)"
  # agy'nin İKİ ÖLÇÜLMÜŞ asimetrisi korunur (spec §5.4.1 + argv-baseline.md).
  # Config'teki sabit `flags` bu ikisini tek başına ifade edemez:
  #   1) --help izin bayrağını desteklemiyorsa TÜM bayraklar düşer (çıplak çağrı).
  #   2) Bayraklar destekleniyor ama PROMPT YOKSA yalnız izin bayrağı geçer;
  #      `--effort low` tek seferlik prompt için konur, interaktif oturumda düşer.
  # Ölçüm (argv-baseline.md, agy dalı): promptlu
  #   `--dangerously-skip-permissions --effort low --prompt PROMPT`
  # promptsuz ise `--dangerously-skip-permissions` (effort YOK).
  # ${flags%% *} ilk bayrağı (izin bayrağını) alır; config'teki sıraya bağlıdır;
  # cachy-agent-agents check bu sırayı agy satırında ZORLAR (bayrak yanlış
  # sırada başlıyorsa check reddeder), yani kural tek yerde aranabilir.
  if [[ "$agent" == "agy" ]]; then
    if ! agy --help 2>&1 | grep -q dangerously-skip-permissions; then
      flags=""
    elif [[ $# -eq 0 ]]; then
      flags="${flags%% *}"
    fi
  fi
  if [[ $# -gt 0 && "$pf" != "-" ]]; then
    # shellcheck disable=SC2086  # flags config'ten kelime kelime ayrılır
    exec "$agent" $flags "$pf" "$*"
  elif [[ $# -gt 0 ]]; then
    # shellcheck disable=SC2086
    exec "$agent" $flags "$*"
  else
    # shellcheck disable=SC2086
    exec "$agent" $flags
  fi
}

cmd="${1:---pick}"
case "$cmd" in
  --inline)
    shift || true
    # ga-style: --inline agy ikinci argüman olabilir, sonrası prompt
    ag="${1:-$(default_agent)}"; shift || true
    run_agent "$ag" "$@"
    ;;
  --pick)
    sel="${2:-$(default_agent)}"
    if [[ "$sel" == "$(default_agent)" && -z "${2:-}" ]]; then
      echo "agent seç ($(cachy-agent-agents ids)) [$(default_agent)]: "; read -r sel; sel="${sel:-$(default_agent)}"
    fi
    if ! cachy-agent-agents known "$sel" 2>/dev/null; then
      echo "bilinmeyen agent: $sel ($(cachy-agent-agents ids))" >&2; exit 1
    fi
    if [[ "${CACHY_AGENT_TERMINAL:-0}" == "1" ]]; then
      # shellcheck disable=SC2016  # $0/$1 ic bash'e gecmeli
      exec alacritty --class CachyAgent -e bash -c '"$0" --inline "$1"; exec fish' "$0" "$sel"
    fi
    run_agent "$sel"
    ;;
  --seed)
    # interaktif session + başlangıç bağlamı (crash devamı için)
    shift || true
    ag="$(default_agent)"
    # yalnızca :71 whitelist'i known'a çevrildi; --seed'in kendi exec case'i korunur
    if [[ -n "${1:-}" ]] && cachy-agent-agents known "$1" 2>/dev/null; then ag="$1"; shift || true; fi
    if [[ -z "${*:-}" ]]; then exec cachy-agent --inline "$ag"; fi
    case "$ag" in
      agy) exec agy --dangerously-skip-permissions --effort low --prompt-interactive "$*" ;;
      opencode) exec opencode --auto --prompt "$*" ;;
      claude) exec claude --permission-mode auto "$*" ;;
    codex|crush|copilot|cursor-agent|grok) exec "$ag" "$*" ;;
      *) echo "bilinmeyen agent: $ag ($(cachy-agent-agents ids))" >&2; exit 1 ;;
    esac
    ;;
  --prompt) shift || true; if [[ -z "${*:-}" ]]; then echo "kullanım: cachy-agent --prompt <metin>" >&2; exit 1; fi; PROMPT="$*"; AGENT="$(default_agent)"; run_agent "$AGENT" "$PROMPT" ;;
  default)
    mkdir -p "$CONFIG_DIR"
    if [[ -n "${2:-}" ]]; then
      if ! cachy-agent-agents known "$2" 2>/dev/null; then
        echo "bilinmeyen agent: $2 ($(cachy-agent-agents ids))" >&2; exit 1
      fi
      echo "$2" > "$DEFAULT_FILE"
    fi
    cat "$DEFAULT_FILE"
    ;;
  crash)
    shift || true
    if [[ "${1:-}" == "mute" ]]; then
      PROG=$(echo "${2:-}" | tr -cd 'A-Za-z0-9._-'); MODE="${3:-on}"
      mkdir -p "$CONFIG_DIR/mute"
      case "$MODE" in
        on)
          # `A && B || C` zinciri BURADA yanlış gerekçe veriyordu: PROG geçerli
          # ama `touch` yetki/salt-okunur dizin yüzünden başarısız olduğunda da
          # C (kullanım hatası) çalışıyordu. İki hata da exit 1 döner ama
          # sebebi farklıdır; if/else dalları ne olduklarını söyler.
          if [[ -z "$PROG" ]]; then
            echo "kullanım: cachy-agent crash mute <program> [on|off]" >&2; exit 1
          elif ! touch "$CONFIG_DIR/mute/$PROG"; then
            echo "susturulamadı: $PROG ($CONFIG_DIR/mute yazılamıyor)" >&2; exit 1
          else
            echo "muted: $PROG"
          fi ;;
        off) rm -f "$CONFIG_DIR/mute/$PROG" && echo "unmuted: $PROG" ;;
        *) echo "kullanım: cachy-agent crash mute <program> [on|off]" >&2; exit 1 ;;
      esac
    else
      exec "$HOME/.local/bin/cachy-agent-crash" "$@"
    fi
    ;;
  usage)
    _udir="${XDG_STATE_HOME:-$HOME/.local/state}/cachy-agent/agents/usage"
    if ! ls "$_udir"/*.json >/dev/null 2>&1; then echo "kayıt yok, \`cachy-agent-usage-update\` çalıştır"; else for _f in "$_udir"/*.json; do python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); lims=",".join(f"{l.get("label",l.get("name",""))} {l.get("percent",l.get("usedPercent","?"))}%" for l in (d.get("limits") or [])) or "-"; print(f"{d.get("id","?")}: today={d.get("todayPrompts",d.get("today",0))} total={d.get("totalPrompts",d.get("total","?"))} limits[{lims}]")' "$_f"; done; fi ;; # usage-summary
  --version|-v)
    _vfile="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/../../VERSION"
    # repo dışı kurulumda VERSION dosyası yoksa sessizce "unknown"
    if [[ -f "$_vfile" ]]; then cat "$_vfile"
    elif [[ -f "$HOME/Projeler/cachy-agent/VERSION" ]]; then cat "$HOME/Projeler/cachy-agent/VERSION"
    else echo "unknown"
    fi
    ;;
  --help|-h)
    # Agent satırı config'ten üretilir; geri kalan metin literal (korunur).
    cat <<'HELP'
cachy-agent - agentic launcher (CachyOS/KDE)
Kullanım:
  cachy-agent --inline [agent] [prompt...]  Seçili agentı aç (varsayılan: default-agent)
  cachy-agent --pick [agent]                Seçim sor (argümansız sorar)
  cachy-agent --prompt <metin>              Default agent'a tek komut gönder
  cachy-agent --seed [ad] <metin>           İnteraktif session + bağlamla başlat
  cachy-agent default [ad]                  Default agentı göster/değiştir
  cachy-agent crash mute <prog> [on|off]    Crash bildirimini sustur/aç
  cachy-agent crash <pid> [comm]            Crash diagnose et
  cachy-agent usage                         Kullanım kayıtları
HELP
    echo "Agentlar: $(cachy-agent-agents ids)"
    cat <<'HELP'
Kısayollar: a (default), ga (agy), SUPER+SHIFT+CTRL+A (menü)
HELP
    ;;
  *) shift || true; run_agent "$(default_agent)" "$@" ;;
esac
