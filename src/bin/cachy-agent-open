#!/usr/bin/env bash
# cachy-agent-open <agent> [başlangıç-metin...] - agentı güvenli açar.
# Metin varsa bağlamlı session (--seed), yoksa düz interaktif.
# Hata olursa pencereyi kapatmadan sebebi + sonraki adımı gösterir.
# Agent adı ve giriş ipucu agents.conf'tan gelir (bilinenler: cachy-agent-agents ids).
set -euo pipefail
AGENT="${1:-}"; shift || true
if ! cachy-agent-agents known "$AGENT" 2>/dev/null; then
  echo "bilinmeyen agent: $AGENT" >&2; exit 1
fi
code=0
if [[ $# -gt 0 ]]; then cachy-agent --seed "$AGENT" "$@" || code=$?; else cachy-agent --inline "$AGENT" || code=$?; fi
if [[ $code -eq 0 ]]; then exit 0; fi
# Config'teki `login` alanı ipucu metninin kendisidir (bir ajanın `login`
# komutu + argümanları). Burada hiçbir ajan adı geçmez.
# `-` (veya boş) ise ajanın girişe ihtiyacı yoktur -> genel ipucu.
# Aynı dosyada iki farklı çağrı yolu karışmasın diye burada da BARE ad
# kullanılır (`known` çağrısıyla aynı). Mutlak `$HOME/.local/bin/...` yolu
# yalnızca QML gibi PATH'e bakmayan tüketicilerde gerekir.
login="$(cachy-agent-agents get "$AGENT" login 2>/dev/null || true)"
if [[ -z "$login" || "$login" == "-" ]]; then
  hint="'cachy-agent --inline $AGENT' ile manuel dene"
else
  hint="terminalde '$login' ile giriş yap"
fi
echo
echo "Agent açılamadı (çıkış kodu: $code)."
echo "Sonraki adım: $hint"
read -rp "Kapatmak için Enter..." || true
exit "$code"
